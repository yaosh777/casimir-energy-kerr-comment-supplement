\begin_inset Formula 
\begin{align*}
\partial_{x}u_{n}\partial_{x}u^{*}_{n} & =\partial_{x}N_{n}e^{-i\omega_{n}t}e^{i\boldsymbol{k}_{\bot}\cdot\boldsymbol{r}_{\bot}}e^{-i\beta_{n}x}\sin\left(\frac{n\pi}{L}x\right)\partial_{x}N_{n}e^{i\omega_{n}t}e^{-i\boldsymbol{k}_{\bot}\cdot\boldsymbol{r}_{\bot}}e^{i\beta_{n}x}\sin\left(\frac{n\pi}{L}x\right)\\
 & =N_{n}e^{-i\omega_{n}t}e^{i\boldsymbol{k}_{\bot}\cdot\boldsymbol{r}_{\bot}}\left[\left(-i\beta_{n}\right)e^{-i\beta_{n}x}\sin\left(\frac{n\pi}{L}x\right)+e^{-i\beta_{n}x}\left(\frac{n\pi}{L}\right)\cos\left(\frac{n\pi}{L}x\right)\right]N_{n}e^{i\omega_{n}t}e^{-i\boldsymbol{k}_{\bot}\cdot\boldsymbol{r}_{\bot}}\left[i\beta_{n}e^{i\beta_{n}x}\sin\left(\frac{n\pi}{L}x\right)+e^{i\beta_{n}x}\left(\frac{n\pi}{L}\right)\cos\left(\frac{n\pi}{L}x\right)\right]\\
 & =N^{2}_{n}\left[\left(-i\beta_{n}\right)e^{-i\beta_{n}x}\sin\left(\frac{n\pi}{L}x\right)i\beta_{n}e^{i\beta_{n}x}\sin\left(\frac{n\pi}{L}x\right)+\left(-i\beta_{n}\right)e^{-i\beta_{n}x}\sin\left(\frac{n\pi}{L}x\right)e^{i\beta_{n}x}\left(\frac{n\pi}{L}\right)\cos\left(\frac{n\pi}{L}x\right)+e^{-i\beta_{n}x}\left(\frac{n\pi}{L}\right)\cos\left(\frac{n\pi}{L}x\right)i\beta_{n}e^{i\beta_{n}x}\sin\left(\frac{n\pi}{L}x\right)+e^{-i\beta_{n}x}\left(\frac{n\pi}{L}\right)\cos\left(\frac{n\pi}{L}x\right)e^{i\beta_{n}x}\left(\frac{n\pi}{L}\right)\cos\left(\frac{n\pi}{L}x\right)\right]\\
