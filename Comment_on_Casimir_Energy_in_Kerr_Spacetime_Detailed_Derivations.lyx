\begin_inset Formula 
\begin{align*}
\frac{1}{2}\hat{g}_{tt}\left(\hat{g}^{\mu\nu}\partial_{\mu}u_{n}\partial_{\nu}u^{*}_{n}\right) & =\frac{1}{2}\hat{g}_{tt}\left(\hat{g}^{tt}\partial_{t}u_{n}\partial_{t}u^{*}_{n}+\hat{g}^{tx}\partial_{t}u_{n}\partial_{x}u^{*}_{n}+\hat{g}^{xt}\partial_{x}u_{n}\partial_{t}u^{*}_{n}+\hat{g}^{xx}\partial_{x}u_{n}\partial_{x}u^{*}_{n}+\hat{g}^{yy}\partial_{y}u_{n}\partial_{y}u^{*}_{n}+\hat{g}^{zz}\partial_{z}u_{n}\partial_{z}u^{*}_{n}\right)\\
 & =\frac{1}{2}\hat{g}_{tt}\left\{ \hat{g}^{tt}\omega^{2}_{n}N^{2}_{n}\sin^{2}\left(\frac{n\pi}{L}x\right)+\hat{g}^{tx}\left[\omega_{n}\beta_{n}N^{2}_{n}\sin^{2}\left(\frac{n\pi}{L}x\right)+\left(-i\omega_{n}\right)\frac{n\pi}{L}N^{2}_{n}\sin\left(\frac{n\pi}{L}x\right)\cos\left(\frac{n\pi}{L}x\right)\right]+\hat{g}^{xt}\left[\beta_{n}\omega_{n}N^{2}_{n}\sin^{2}\left(\frac{n\pi}{L}x\right)+i\omega_{n}\frac{n\pi}{L}N^{2}_{n}\cos\left(\frac{n\pi}{L}x\right)\sin\left(\frac{n\pi}{L}x\right)\right]+\hat{g}^{xx}N^{2}_{n}\left[\beta^{2}_{n}\sin^{2}\left(\frac{n\pi}{L}x\right)+\left(\frac{n\pi}{L}\right)^{2}\cos^{2}\left(\frac{n\pi}{L}x\right)\right]+\hat{g}^{yy}k^{2}_{y}N^{2}_{n}\sin^{2}\left(\frac{n\pi}{L}x\right)+\hat{g}^{zz}k^{2}_{z}N^{2}_{n}\sin^{2}\left(\frac{n\pi}{L}x\right)\right\} \\
 & =\frac{1}{2}\hat{g}_{tt}\left\{ \hat{g}^{tt}\omega^{2}_{n}N^{2}_{n}\sin^{2}\left(\frac{n\pi}{L}x\right)+\hat{g}^{tx}\omega_{n}\beta_{n}N^{2}_{n}\sin^{2}\left(\frac{n\pi}{L}x\right)+\hat{g}^{xt}\beta_{n}\omega_{n}N^{2}_{n}\sin^{2}\left(\frac{n\pi}{L}x\right)+\hat{g}^{xx}N^{2}_{n}\left[\beta^{2}_{n}\sin^{2}\left(\frac{n\pi}{L}x\right)+\left(\frac{n\pi}{L}\right)^{2}\cos^{2}\left(\frac{n\pi}{L}x\right)\right]+\hat{g}^{yy}k^{2}_{y}N^{2}_{n}\sin^{2}\left(\frac{n\pi}{L}x\right)+\hat{g}^{zz}k^{2}_{z}N^{2}_{n}\sin^{2}\left(\frac{n\pi}{L}x\right)\right\} \\
 & =\frac{1}{2}\hat{g}_{tt}\left\{ \hat{g}^{tt}\omega^{2}_{n}N^{2}_{n}\sin^{2}\left(\frac{n\pi}{L}x\right)+2\hat{g}^{tx}\omega_{n}\beta_{n}N^{2}_{n}\sin^{2}\left(\frac{n\pi}{L}x\right)+\hat{g}^{xx}N^{2}_{n}\left[\beta^{2}_{n}\sin^{2}\left(\frac{n\pi}{L}x\right)+\left(\frac{n\pi}{L}\right)^{2}\cos^{2}\left(\frac{n\pi}{L}x\right)\right]+\hat{g}^{yy}k^{2}_{y}N^{2}_{n}\sin^{2}\left(\frac{n\pi}{L}x\right)+\hat{g}^{zz}k^{2}_{z}N^{2}_{n}\sin^{2}\left(\frac{n\pi}{L}x\right)\right\} 
\end{align*}

\end_inset

 Hence,
 
\begin_inset Formula 
\[
\partial_{t}u_{n}\partial_{t}u^{*}_{n}-\frac{1}{2}\hat{g}_{tt}\left(\hat{g}^{\mu\nu}\partial_{\mu}u_{n}\partial_{\nu}u^{*}_{n}\right)=\omega^{2}_{n}N^{2}_{n}\sin^{2}\left(\frac{n\pi}{L}x\right)-\frac{1}{2}\hat{g}_{tt}\left\{ \hat{g}^{tt}\omega^{2}_{n}N^{2}_{n}\sin^{2}\left(\frac{n\pi}{L}x\right)+2\hat{g}^{tx}\omega_{n}\beta_{n}N^{2}_{n}\sin^{2}\left(\frac{n\pi}{L}x\right)+\hat{g}^{xx}N^{2}_{n}\left[\beta^{2}_{n}\sin^{2}\left(\frac{n\pi}{L}x\right)+\left(\frac{n\pi}{L}\right)^{2}\cos^{2}\left(\frac{n\pi}{L}x\right)\right]+\hat{g}^{yy}k^{2}_{y}N^{2}_{n}\sin^{2}\left(\frac{n\pi}{L}x\right)+\hat{g}^{zz}k^{2}_{z}N^{2}_{n}\sin^{2}\left(\frac{n\pi}{L}x\right)\right\} 
\]

\end_inset

 Write 
\begin_inset Formula $k_{n}=\frac{n\pi}{L}$
\end_inset

,
 
\begin_inset Formula $S_{x}=\sin^{2}\left(k_{n}x\right)$
\end_inset

,
 and 
\begin_inset Formula $C_{x}=\cos^{2}\left(k_{n}x\right)$
\end_inset

.
 Then 
\begin_inset Formula 
\begin{align*}
\partial_{t}u_{n}\partial_{t}u^{*}_{n}-\frac{1}{2}\hat{g}_{tt}\left(\hat{g}^{\mu\nu}\partial_{\mu}u_{n}\partial_{\nu}u^{*}_{n}\right) & =\omega^{2}_{n}N^{2}_{n}S_{x}-\frac{1}{2}\hat{g}_{tt}\left[\hat{g}^{tt}\omega^{2}_{n}N^{2}_{n}S_{x}+2\hat{g}^{tx}\omega_{n}\beta_{n}N^{2}_{n}S_{x}+\hat{g}^{xx}N^{2}_{n}\left(\beta^{2}_{n}S_{x}+k^{2}_{n}C_{x}\right)+\hat{g}^{yy}k^{2}_{y}N^{2}_{n}S_{x}+\hat{g}^{zz}k^{2}_{z}N^{2}_{n}S_{x}\right]\\
 & =\omega^{2}_{n}N^{2}_{n}S_{x}-\frac{1}{2}\hat{g}_{tt}\left[\left(\hat{g}^{tt}\omega^{2}_{n}+2\hat{g}^{tx}\omega_{n}\beta_{n}+\hat{g}^{xx}\beta^{2}_{n}\right)N^{2}_{n}S_{x}+\hat{g}^{xx}N^{2}_{n}k^{2}_{n}C_{x}+\hat{g}^{yy}k^{2}_{y}N^{2}_{n}S_{x}+\hat{g}^{zz}k^{2}_{z}N^{2}_{n}S_{x}\right]\\
 & =\omega^{2}_{n}N^{2}_{n}S_{x}-\frac{1}{2}\hat{g}_{tt}\left[\omega^{2}_{n}C^{2}\left(\Omega\right)N^{2}_{n}S_{x}+\hat{g}^{xx}N^{2}_{n}k^{2}_{n}C_{x}+\hat{g}^{yy}k^{2}_{y}N^{2}_{n}S_{x}+\hat{g}^{zz}k^{2}_{z}N^{2}_{n}S_{x}\right]\\
 & =\omega^{2}_{n}N^{2}_{n}S_{x}-\frac{1}{2}C^{-2}\left(\Omega\right)\left\{ \omega^{2}_{n}C^{2}\left(\Omega\right)N^{2}_{n}S_{x}+\left[-\frac{r^{2}}{\Delta}C^{-2}\left(\Omega\right)\right]N^{2}_{n}k^{2}_{n}C_{x}+\left(-\frac{\Delta}{r^{2}}\right)k^{2}_{y}N^{2}_{n}S_{x}+\left(-1\right)k^{2}_{z}N^{2}_{n}S_{x}\right\} \\
 & =\omega^{2}_{n}N^{2}_{n}S_{x}-\frac{1}{2}N^{2}_{n}\left\{ \omega^{2}_{n}S_{x}-\frac{r^{2}}{\Delta}C^{-4}\left(\Omega\right)k^{2}_{n}C_{x}-C^{-2}\left(\Omega\right)\frac{\Delta}{r^{2}}k^{2}_{y}S_{x}-C^{-2}\left(\Omega\right)k^{2}_{z}S_{x}\right\} \\
 & =N^{2}_{n}\left[\frac{1}{2}\omega^{2}_{n}S_{x}+\frac{1}{2}\frac{r^{2}}{\Delta}C^{-4}\left(\Omega\right)k^{2}_{n}C_{x}+\frac{1}{2}C^{-2}\left(\Omega\right)\left(\frac{\Delta}{r^{2}}k^{2}_{y}+k^{2}_{z}\right)S_{x}\right]\\
 & =N^{2}_{n}\left[\frac{1}{2}\omega^{2}_{n}S_{x}+\frac{1}{2}\frac{r^{2}}{\Delta}C^{-4}\left(\Omega\right)k^{2}_{n}C_{x}+\frac{1}{2}\left[\omega^{2}_{n}-\frac{r^{2}}{\Delta}C^{-4}\left(\Omega\right)k^{2}_{n}\right]S_{x}\right]\\
 & =N^{2}_{n}\left[\omega^{2}_{n}S_{x}+\frac{1}{2}\frac{r^{2}}{\Delta}C^{-4}\left(\Omega\right)k^{2}_{n}C_{x}-\frac{1}{2}\frac{r^{2}}{\Delta}C^{-4}\left(\Omega\right)k^{2}_{n}S_{x}\right]\\
 & =N^{2}_{n}\left[\omega^{2}_{n}S_{x}+\frac{1}{2}\frac{r^{2}}{\Delta}C^{-4}\left(\Omega\right)k^{2}_{n}\left(C_{x}-S_{x}\right)\right]\\
 & =N^{2}_{n}\left[\omega^{2}_{n}S_{x}+\frac{1}{2}\frac{r^{2}}{\Delta}C^{-4}\left(\Omega\right)k^{2}_{n}\cos\left(2k_{n}x\right)\right]\\
 & =N^{2}_{n}\left[\omega^{2}_{n}\sin^{2}\left(\frac{n\pi}{L}x\right)+\frac{1}{2}\frac{r^{2}}{\Delta}C^{-4}\left(\Omega\right)\left(\frac{n\pi}{L}\right)^{2}\cos\left(\frac{2n\pi}{L}x\right)\right]
\end{align*}

\end_inset

 where 
\begin_inset Formula 
\begin{align*}
\hat{g}^{tt}\omega^{2}_{n}+2\hat{g}^{tx}\omega_{n}\beta_{n}+\hat{g}^{xx}\beta^{2}_{n} & =\frac{A}{\Delta r^{2}}\omega^{2}_{n}+2\frac{A}{\Delta r}\left(\omega_{d}-\Omega\right)\omega_{n}\cdot\frac{\omega_{n}C^{2}\left(\Omega\right)A}{r^{3}}\left(\omega_{d}-\Omega\right)+\left[-\frac{r^{2}}{\Delta}C^{-2}\left(\Omega\right)\right]\left[\frac{\omega_{n}C^{2}\left(\Omega\right)A}{r^{3}}\left(\omega_{d}-\Omega\right)\right]^{2}\\
 & =\frac{A}{\Delta r^{2}}\omega^{2}_{n}+2\frac{A^{2}}{\Delta r^{4}}\left(\omega_{d}-\Omega\right)^{2}\omega^{2}_{n}C^{2}\left(\Omega\right)-\frac{r^{2}}{\Delta}C^{-2}\left(\Omega\right)\frac{\omega^{2}_{n}C^{4}\left(\Omega\right)A^{2}}{r^{6}}\left(\omega_{d}-\Omega\right)^{2}\\
 & =\frac{A}{\Delta r^{2}}\omega^{2}_{n}+2\frac{A^{2}}{\Delta r^{4}}\left(\omega_{d}-\Omega\right)^{2}\omega^{2}_{n}C^{2}\left(\Omega\right)-\frac{A^{2}}{\Delta r^{4}}\left(\omega_{d}-\Omega\right)^{2}\omega^{2}_{n}C^{2}\left(\Omega\right)\\
 & =\frac{A}{\Delta r^{2}}\omega^{2}_{n}+\frac{A^{2}}{\Delta r^{4}}\left(\omega_{d}-\Omega\right)^{2}\omega^{2}_{n}C^{2}\left(\Omega\right)
\end{align*}

\end_inset

 and 
\begin_inset Formula 
\begin{align*}
\frac{A}{\Delta r^{2}}\omega^{2}_{n}+\frac{A^{2}}{\Delta r^{4}}\left(\omega_{d}-\Omega\right)^{2}\omega^{2}_{n}C^{2}\left(\Omega\right) & =\left[\frac{A}{\Delta r^{2}}C^{-2}\left(\Omega\right)+\frac{A^{2}}{\Delta r^{4}}\left(\omega_{d}-\Omega\right)^{2}\right]\omega^{2}_{n}C^{2}\left(\Omega\right)\\
 & =\left\{ \frac{A}{\Delta r^{2}}\cdot\frac{\Delta r^{2}}{A}\left[1-\frac{A^{2}}{\Delta r^{4}}\left(\Omega-\omega_{d}\right)^{2}\right]+\frac{A^{2}}{\Delta r^{4}}\left(\omega_{d}-\Omega\right)^{2}\right\} \omega^{2}_{n}C^{2}\left(\Omega\right)\\
 & =\left[1-\frac{A^{2}}{\Delta r^{4}}\left(\Omega-\omega_{d}\right)^{2}+\frac{A^{2}}{\Delta r^{4}}\left(\omega_{d}-\Omega\right)^{2}\right]\omega^{2}_{n}C^{2}\left(\Omega\right)\\
 & =\omega^{2}_{n}C^{2}\left(\Omega\right)
\end{align*}

\end_inset

 This gives 
\begin_inset Formula 
\[
\hat{g}^{tt}\omega^{2}_{n}+2\hat{g}^{tx}\omega_{n}\beta_{n}+\hat{g}^{xx}\beta^{2}_{n}=\omega^{2}_{n}C^{2}\left(\Omega\right)
\]

\end_inset

 Also,
 
\begin_inset Formula 
\begin{align*}
\omega^{2}_{n} & =\frac{r^{2}}{\Delta}C^{-4}\left(\Omega\right)\left[k^{2}_{n}+\frac{\Delta}{r^{2}}C^{2}\left(\Omega\right)\left(\frac{\Delta}{r^{2}}k^{2}_{y}+k^{2}_{z}\right)\right]\\
 & =\frac{r^{2}}{\Delta}C^{-4}\left(\Omega\right)k^{2}_{n}+C^{-2}\left(\Omega\right)\left(\frac{\Delta}{r^{2}}k^{2}_{y}+k^{2}_{z}\right)
\end{align*}

\end_inset

 which gives 
\begin_inset Formula 
\[
C^{-2}\left(\Omega\right)\left(\frac{\Delta}{r^{2}}k^{2}_{y}+k^{2}_{z}\right)=\omega^{2}_{n}-\frac{r^{2}}{\Delta}C^{-4}\left(\Omega\right)k^{2}_{n}
\]

\end_inset

 Finally,
 
\begin_inset Formula 
\[
C_{x}-S_{x}=\cos^{2}\left(k_{n}x\right)-\sin^{2}\left(k_{n}x\right)=\cos\left(2k_{n}x\right)
\]

\end_inset

 by the double-angle identity 
\begin_inset Formula $\cos2\alpha=\cos^{2}\alpha-\sin^{2}\alpha$
\end_inset

.
\end_layout

\begin_layout Standard
Alternatively,
 
\begin_inset Formula 
\begin{align*}
\partial_{t}u_{n}\partial_{t}u^{*}_{n}-\frac{1}{2}\hat{g}_{tt}\left(\hat{g}^{\mu\nu}\partial_{\mu}u_{n}\partial_{\nu}u^{*}_{n}\right) & =N^{2}_{n}\left[\omega^{2}_{n}\sin^{2}\left(\frac{n\pi}{L}x\right)+\frac{1}{2}\frac{r^{2}}{\Delta}C^{-4}\left(\Omega\right)\left(\frac{n\pi}{L}\right)^{2}\cos\left(\frac{2n\pi}{L}x\right)\right]\\
 & =N^{2}_{n}\left\{ \omega^{2}_{n}\sin^{2}\left(k_{n}x\right)+\frac{1}{2}\frac{r^{2}}{\Delta}C^{-4}\left(\Omega\right)k^{2}_{n}\left[\cos^{2}\left(k_{n}x\right)-\sin^{2}\left(k_{n}x\right)\right]\right\} \\
 & =N^{2}_{n}\left\{ \left[\omega^{2}_{n}-\frac{1}{2}\frac{r^{2}}{\Delta}C^{-4}\left(\Omega\right)k^{2}_{n}\right]\sin^{2}\left(k_{n}x\right)+\frac{1}{2}\frac{r^{2}}{\Delta}C^{-4}\left(\Omega\right)k^{2}_{n}\cos^{2}\left(k_{n}x\right)\right\} \\
 & =\frac{1}{2}N^{2}_{n}\left\{ \left[2\omega^{2}_{n}-\frac{r^{2}}{\Delta}C^{-4}\left(\Omega\right)k^{2}_{n}\right]\sin^{2}\left(k_{n}x\right)+\frac{r^{2}}{\Delta}C^{-4}\left(\Omega\right)k^{2}_{n}\cos^{2}\left(k_{n}x\right)\right\} \\
 & =\frac{1}{2}N^{2}_{n}\left\{ \left[\omega^{2}_{n}+\frac{\omega_{n}}{b_{n}}\left(\frac{\Delta}{r^{2}}k^{2}_{y}+k^{2}_{z}\right)\right]\sin^{2}\left(k_{n}x\right)+\frac{\omega^{2}_{n}r^{2}}{b^{2}_{n}\Delta}k^{2}_{n}\cos^{2}\left(k_{n}x\right)\right\} \\
 & =\frac{1}{2}N^{2}_{n}\left\{ \mathcal{F}_{n}\sin^{2}\left(k_{n}x\right)+\mathcal{G}_{n}\cos^{2}\left(k_{n}x\right)\right\} 
\end{align*}

\end_inset

 where we define 
\begin_inset Formula 
\[
\mathcal{F}_{n}=\omega^{2}_{n}+\frac{\omega_{n}}{b_{n}}\left(\frac{\Delta}{r^{2}}k^{2}_{y}+k^{2}_{z}\right)
\]

\end_inset

 
\begin_inset Formula 
\[
\mathcal{G}_{n}=\frac{\omega^{2}_{n}r^{2}}{b^{2}_{n}\Delta}k^{2}_{n}
\]

\end_inset

 We also have 
\begin_inset Formula 
\[
\omega_{n}=\frac{r}{\sqrt{\Delta}}C^{-2}\left(\Omega\right)\sqrt{k^{2}_{n}+\frac{\Delta}{r^{2}}C^{2}\left(\Omega\right)\left(\frac{\Delta}{r^{2}}k^{2}_{y}+k^{2}_{z}\right)}
\]

\end_inset

 
\begin_inset Formula 
\[
\omega^{2}_{n}=\frac{r^{2}}{\Delta}C^{-4}\left(\Omega\right)k^{2}_{n}+C^{-2}\left(\Omega\right)\left(\frac{\Delta}{r^{2}}k^{2}_{y}+k^{2}_{z}\right)
\]

\end_inset

 
\begin_inset Formula 
\[
\beta_{n}=\frac{b_{n}A}{r^{3}}\left(\omega_{d}-\Omega\right)
\]

\end_inset

 
\begin_inset Formula 
\[
b_{n}=\omega_{n}C^{2}\left(\Omega\right)
\]

\end_inset

 
\begin_inset Formula 
\[
k_{n}=\frac{n\pi}{L}
\]

\end_inset

 
\begin_inset Formula 
\begin{align*}
2\omega^{2}_{n}-\frac{r^{2}}{\Delta}C^{-4}\left(\Omega\right)k^{2}_{n} & =\omega^{2}_{n}+\omega^{2}_{n}-\frac{r^{2}}{\Delta}C^{-4}\left(\Omega\right)k^{2}_{n}\\
 & =\omega^{2}_{n}+\left[\frac{r^{2}}{\Delta}C^{-4}\left(\Omega\right)k^{2}_{n}+C^{-2}\left(\Omega\right)\left(\frac{\Delta}{r^{2}}k^{2}_{y}+k^{2}_{z}\right)\right]-\frac{r^{2}}{\Delta}C^{-4}\left(\Omega\right)k^{2}_{n}\\
 & =\omega^{2}_{n}+C^{-2}\left(\Omega\right)\left(\frac{\Delta}{r^{2}}k^{2}_{y}+k^{2}_{z}\right)\\
 & =\omega^{2}_{n}+\frac{\omega_{n}}{\omega_{n}C^{2}\left(\Omega\right)}\left(\frac{\Delta}{r^{2}}k^{2}_{y}+k^{2}_{z}\right)\\
 & =\omega^{2}_{n}+\frac{\omega_{n}}{b_{n}}\left(\frac{\Delta}{r^{2}}k^{2}_{y}+k^{2}_{z}\right)
\end{align*}

\end_inset

 
\begin_inset Formula 
\begin{align*}
\frac{r^{2}}{\Delta}C^{-4}\left(\Omega\right)k^{2}_{n} & =\frac{\omega^{2}_{n}r^{2}}{\omega^{2}_{n}C^{4}\left(\Omega\right)\Delta}k^{2}_{n}\\
 & =\frac{\omega^{2}_{n}r^{2}}{b^{2}_{n}\Delta}k^{2}_{n}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
We obtain 
\begin_inset Formula 
\begin{align*}
\langle\epsilon_{\text{vac}}\rangle & =C^{2}\left(\Omega\right)\frac{1}{L\int^{+\infty}_{-\infty}\int^{+\infty}_{-\infty}dydz}\int^{L}_{0}dx\int^{+\infty}_{-\infty}\int^{+\infty}_{-\infty}dydz\langle0\vert T_{tt}\vert0\rangle\\
 & =C^{2}\left(\Omega\right)\frac{1}{L\int^{+\infty}_{-\infty}\int^{+\infty}_{-\infty}dydz}\int^{L}_{0}dx\int^{+\infty}_{-\infty}\int^{+\infty}_{-\infty}dydz\sum_{n}\int d^{2}k_{\perp}\left[\partial_{t}u_{n}\partial_{t}u^{*}_{n}-\frac{1}{2}\hat{g}_{tt}\left(\hat{g}^{\mu\nu}\partial_{\mu}u_{n}\partial_{\nu}u^{*}_{n}\right)\right]\\
 & =C^{2}\left(\Omega\right)\frac{1}{L\int^{+\infty}_{-\infty}\int^{+\infty}_{-\infty}dydz}\int^{L}_{0}dx\int^{+\infty}_{-\infty}\int^{+\infty}_{-\infty}dydz\sum_{n}\int d^{2}k_{\perp}\left\{ N^{2}_{n}\left[\omega^{2}_{n}\sin^{2}\left(\frac{n\pi}{L}x\right)+\frac{1}{2}\frac{r^{2}}{\Delta}C^{-4}\left(\Omega\right)\left(\frac{n\pi}{L}\right)^{2}\cos\left(\frac{2n\pi}{L}x\right)\right]\right\} \\
 & =\frac{C^{2}\left(\Omega\right)}{L}\int^{L}_{0}dx\sum_{n}\int d^{2}k_{\perp}N^{2}_{n}\left[\omega^{2}_{n}\sin^{2}\left(\frac{n\pi}{L}x\right)+\frac{1}{2}\frac{r^{2}}{\Delta}C^{-4}\left(\Omega\right)\left(\frac{n\pi}{L}\right)^{2}\cos\left(\frac{2n\pi}{L}x\right)\right]\\
 & =\frac{C^{2}\left(\Omega\right)}{L}\sum_{n}\int d^{2}k_{\perp}N^{2}_{n}\left[\omega^{2}_{n}\int^{L}_{0}\sin^{2}\left(\frac{n\pi}{L}x\right)dx+\frac{1}{2}\frac{r^{2}}{\Delta}C^{-4}\left(\Omega\right)\left(\frac{n\pi}{L}\right)^{2}\int^{L}_{0}\cos\left(\frac{2n\pi}{L}x\right)dx\right]\\
 & =\frac{C^{2}\left(\Omega\right)}{L}\sum_{n}\int d^{2}k_{\perp}N^{2}_{n}\omega^{2}_{n}\frac{L}{2}\\
 & =\frac{C^{2}\left(\Omega\right)}{2}\sum_{n}\int d^{2}k_{\perp}N^{2}_{n}\omega^{2}_{n}
\end{align*}

\end_inset

 Here,
 
\begin_inset Formula $\langle0\vert T_{tt}\vert0\rangle$
\end_inset

 is independent of 
\begin_inset Formula $y,z$
\end_inset

,
 so the integral 
\begin_inset Formula $\int^{+\infty}_{-\infty}\int^{+\infty}_{-\infty}dydz$
\end_inset

 can be factored out.
 We have 
\begin_inset Formula $\int^{L}_{0}\sin^{2}\left(\frac{n\pi}{L}x\right)dx=\int^{L}_{0}\frac{1-\cos\left(2\frac{n\pi}{L}x\right)}{2}dx=\frac{L}{2}$
\end_inset

 and 
\begin_inset Formula $\int^{L}_{0}\cos\left(\frac{2n\pi}{L}x\right)dx=\left.\frac{L}{2n\pi}\sin\left(\frac{2n\pi}{L}x\right)\right|^{L}_{0}=\frac{L}{2n\pi}\left[\sin(2n\pi)-0\right]=0$
\end_inset

 (since 
\begin_inset Formula $\sin2n\pi=0$
\end_inset

).
 Also,
 
\begin_inset Formula $N^{2}_{n}=\frac{1}{\left(2\pi\right)^{2}L\omega_{n}C^{2}\left(\Omega\right)}$
\end_inset

.
 
\begin_inset Formula 
\begin{align*}
\langle\epsilon_{\text{vac}}\rangle & =\frac{C^{2}\left(\Omega\right)}{2}\sum_{n}\int d^{2}k_{\perp}N^{2}_{n}\omega^{2}_{n}\\
 & =\frac{C^{2}\left(\Omega\right)}{2}\sum_{n}\int d^{2}k_{\perp}\frac{1}{\left(2\pi\right)^{2}L\omega_{n}C^{2}\left(\Omega\right)}\omega^{2}_{n}\\
 & =\frac{1}{2\left(2\pi\right)^{2}L}\sum_{n}\int d^{2}k_{\perp}\omega_{n}\\
 & =\frac{1}{2\left(2\pi\right)^{2}L}\sum_{n}\int d^{2}k_{\perp}\left[\frac{r}{\sqrt{\Delta}}C^{-2}\left(\Omega\right)\sqrt{\left(\frac{n\pi}{L}\right)^{2}+\frac{\Delta}{r^{2}}C^{2}\left(\Omega\right)\left(\frac{\Delta}{r^{2}}k^{2}_{y}+k^{2}_{z}\right)}\right]\\
 & =\frac{1}{2\left(2\pi\right)^{2}L}\sum_{n}\int d^{2}k_{\perp}\left\{ \frac{r}{\sqrt{\Delta}}C^{-2}\left(\Omega\right)\sqrt{\frac{\Delta}{r^{2}}C^{2}\left(\Omega\right)\left[\frac{r^{2}}{\Delta}C^{-2}\left(\Omega\right)\left(\frac{n\pi}{L}\right)^{2}+\left(\frac{\Delta}{r^{2}}k^{2}_{y}+k^{2}_{z}\right)\right]}\right\} \\
 & =\frac{1}{2\left(2\pi\right)^{2}L}\sum_{n}\int d^{2}k_{\perp}\left[\frac{r}{\sqrt{\Delta}}C^{-2}\left(\Omega\right)\cdot\frac{\sqrt{\Delta}}{r}C\left(\Omega\right)\sqrt{\frac{r^{2}}{\Delta}C^{-2}\left(\Omega\right)\left(\frac{n\pi}{L}\right)^{2}+\frac{\Delta}{r^{2}}k^{2}_{y}+k^{2}_{z}}\right]\\
 & =\frac{1}{2\left(2\pi\right)^{2}L}\sum_{n}\int d^{2}k_{\perp}\left[C^{-1}\left(\Omega\right)\sqrt{\frac{r^{2}}{\Delta}C^{-2}\left(\Omega\right)\left(\frac{n\pi}{L}\right)^{2}+\frac{\Delta}{r^{2}}k^{2}_{y}+k^{2}_{z}}\right]
\end{align*}

\end_inset

 Define 
\begin_inset Formula 
\[
s=\frac{r^{2}}{\Delta}C^{-2}\left(\Omega\right)\left(\frac{n\pi}{L}\right)^{2}
\]

\end_inset

 
\begin_inset Formula 
\[
\tilde{k}_{y}=\frac{\sqrt{\Delta}}{r}k_{y}
\]

\end_inset

 Then 
\begin_inset Formula 
\begin{align*}
\sum_{n}\int d^{2}k_{\perp}\omega_{n} & =\sum_{n}\int d^{2}k_{\perp}\left[C^{-1}\left(\Omega\right)\sqrt{\frac{r^{2}}{\Delta}C^{-2}\left(\Omega\right)\left(\frac{n\pi}{L}\right)^{2}+\frac{\Delta}{r^{2}}k^{2}_{y}+k^{2}_{z}}\right]\\
 & =C^{-1}\left(\Omega\right)\sum_{n}\int d^{2}k_{\perp}\sqrt{s+\tilde{k}^{2}_{y}+k^{2}_{z}}\\
 & =\frac{r}{C\left(\Omega\right)\sqrt{\Delta}}\sum_{n}\int d^{2}\tilde{k}_{\perp}\left(s+\tilde{k}^{2}_{y}+k^{2}_{z}\right)^{1/2}
\end{align*}

\end_inset

 where 
\begin_inset Formula $k_{y}=\frac{r}{\sqrt{\Delta}}\tilde{k}_{y}$
\end_inset

,
 
\begin_inset Formula $dk_{y}=d\left(\frac{r}{\sqrt{\Delta}}\tilde{k}_{y}\right)$
\end_inset

,
 and 
\begin_inset Formula $d^{2}k_{\perp}=dk_{y}dk_{z}=d\left(\frac{r}{\sqrt{\Delta}}\tilde{k}_{y}\right)dk_{z}=\frac{r}{\sqrt{\Delta}}d\tilde{k}_{y}dk_{z}$
\end_inset

;
 also,
 
\begin_inset Formula $d^{2}\tilde{k}_{\perp}=d\tilde{k}_{y}dk_{z}$
\end_inset

.
 Apply the Schwinger proper-time method to evaluate the momentum-space integral:
 
\begin_inset Formula 
\begin{align*}
\int d^{2}\tilde{k}_{\perp}\left(s+\tilde{k}^{2}_{y}+k^{2}_{z}\right)^{1/2} & =\int d^{2}\tilde{k}_{\perp}\frac{1}{\Gamma\left(-1/2\right)}\int^{\infty}_{0}dtt^{-\frac{1}{2}-1}e^{-t\left(s+\tilde{k}^{2}_{y}+k^{2}_{z}\right)}\\
 & =\int d^{2}\tilde{k}_{\perp}\left[-\frac{1}{2\sqrt{\pi}}\int^{\infty}_{0}dtt^{-\frac{3}{2}}e^{-t\left(s+\tilde{k}^{2}_{y}+k^{2}_{z}\right)}\right]\\
 & =-\frac{1}{2\sqrt{\pi}}\int^{\infty}_{0}dtt^{-\frac{3}{2}}\int^{\infty}_{-\infty}e^{-t\tilde{k}^{2}_{y}}d\tilde{k}_{y}\int^{\infty}_{-\infty}e^{-tk^{2}_{z}}dk_{z}e^{-ts}\\
 & =-\frac{1}{2\sqrt{\pi}}\int^{\infty}_{0}dtt^{-\frac{3}{2}}\frac{\pi}{t}e^{-ts}\\
 & =-\frac{\sqrt{\pi}}{2}\int^{\infty}_{0}dtt^{-\frac{3}{2}-1}e^{-ts}\\
 & =-\frac{\sqrt{\pi}}{2}s^{3/2}\Gamma\left(-\frac{3}{2}\right)\\
 & =-\frac{\sqrt{\pi}}{2}s^{3/2}\frac{4\sqrt{\pi}}{3}\\
 & =-\frac{2\pi}{3}s^{3/2}
\end{align*}

\end_inset

 Here,
 after analytic continuation,
 
\begin_inset Formula $A^{-\alpha}=\frac{1}{\Gamma\left(\alpha\right)}\int^{\infty}_{0}dtt^{\alpha-1}e^{-tA}$
\end_inset

;
 
\begin_inset Formula $\frac{1}{\Gamma\left(-1/2\right)}=-\frac{1}{2\sqrt{\pi}}$
\end_inset

;
 
\begin_inset Formula $\int^{\infty}_{-\infty}e^{-t\tilde{k}^{2}_{y}}d\tilde{k}_{y}=\int^{\infty}_{-\infty}e^{-tk^{2}_{z}}dk_{z}=\sqrt{\frac{\pi}{t}}$
\end_inset

;
 
\begin_inset Formula $\int^{\infty}_{0}t^{z-1}e^{-ts}dt=s^{-z}\Gamma\left(z\right)$
\end_inset

;
 and 
\begin_inset Formula $\Gamma\left(-\frac{3}{2}\right)=\frac{4\sqrt{\pi}}{3}$
\end_inset

.
 Hence,
 
\begin_inset Formula 
\begin{align*}
\sum_{n}\int d^{2}k_{\perp}\omega_{n} & =\frac{r}{C\left(\Omega\right)\sqrt{\Delta}}\sum_{n}\int d^{2}\tilde{k}_{\perp}\left(s+\tilde{k}^{2}_{y}+k^{2}_{z}\right)^{1/2}\\
 & =\frac{r}{C\left(\Omega\right)\sqrt{\Delta}}\sum_{n}\left(-\frac{2\pi}{3}s^{3/2}\right)\\
 & =\frac{r}{C\left(\Omega\right)\sqrt{\Delta}}\sum_{n}\left\{ -\frac{2\pi}{3}\left[\frac{r^{2}}{\Delta}C^{-2}\left(\Omega\right)\left(\frac{n\pi}{L}\right)^{2}\right]^{3/2}\right\} \\
 & =\frac{r^{4}}{C^{4}\left(\Omega\right)\Delta^{2}}\sum_{n}\left[-\frac{2\pi}{3}\left(\frac{n\pi}{L}\right)^{3}\right]\\
 & =-\frac{2\pi^{4}}{3L^{3}}\frac{r^{4}}{C^{4}\left(\Omega\right)\Delta^{2}}\sum_{n}n^{3}
\end{align*}

\end_inset

 Applying Riemann 
\begin_inset Formula $\zeta$
\end_inset

-function regularization,
 
\begin_inset Formula $\sum^{\infty}_{n=1}n^{3}\rightarrow\zeta\left(-3\right)=\frac{1}{120}$
\end_inset

.
 We obtain 
\begin_inset Formula 
\begin{align*}
\sum_{n}\int d^{2}k_{\perp}\omega_{n} & =-\frac{2\pi^{4}}{3L^{3}}\frac{r^{4}}{C^{4}\left(\Omega\right)\Delta^{2}}\cdot\frac{1}{120}\\
 & =-\frac{\pi^{4}}{180L^{3}}\frac{r^{4}}{C^{4}\left(\Omega\right)\Delta^{2}}
\end{align*}

\end_inset

 and consequently 
\begin_inset Formula 
\begin{align*}
\langle\epsilon_{\text{vac}}\rangle & =\frac{1}{2\left(2\pi\right)^{2}L}\sum_{n}\int d^{2}k_{\perp}\omega_{n}\\
 & =\frac{1}{8\pi^{2}L}\left(-\frac{\pi^{4}}{180L^{3}}\frac{r^{4}}{C^{4}\left(\Omega\right)\Delta^{2}}\right)\\
 & =-\frac{\pi^{2}}{1440L^{4}}\frac{r^{4}}{C^{4}\left(\Omega\right)\Delta^{2}}
\end{align*}

\end_inset

 The proper length of the Casimir cavity is obtained as follows.
 For 
\begin_inset Formula $ds^{2}=\hat{g}_{tt}d\tilde{t}^{2}+\left(\hat{g}_{xx}-\frac{\hat{g}^{2}_{tx}}{\hat{g}_{tt}}\right)dx^{2}+\hat{g}_{yy}dy^{2}+\hat{g}_{zz}dz^{2}$
\end_inset

 with 
\begin_inset Formula $d\tilde{t}=dy=dz=0$
\end_inset

,
 a spacelike interval is negative under the signature 
\begin_inset Formula $(+,-,-,-)$
\end_inset

,
 so the absolute value must be taken under the square root:
 
\begin_inset Formula $ds=\sqrt{\left|\hat{g}_{xx}-\frac{\hat{g}^{2}_{tx}}{\hat{g}_{tt}}\right|}dx$
\end_inset

.
 Thus,
 
\begin_inset Formula 
\[
L_{p}=\int^{L}_{0}ds=\int^{L}_{0}\sqrt{\left|\hat{g}_{xx}-\frac{\hat{g}^{2}_{tx}}{\hat{g}_{tt}}\right|}dx
\]

\end_inset

 With the metric approximated as constant,
 
\begin_inset Formula 
\begin{align*}
L_{p} & =\sqrt{\left|\hat{g}_{xx}-\frac{\hat{g}^{2}_{tx}}{\hat{g}_{tt}}\right|}\int^{L}_{0}dx\\
 & =L\sqrt{\left|\hat{g}_{xx}-\frac{\hat{g}^{2}_{tx}}{\hat{g}_{tt}}\right|}\\
 & =L\sqrt{\left|-\frac{\Delta}{r^{2}}C^{2}\left(\Omega\right)\right|}\\
 & =L\sqrt{\frac{\Delta}{r^{2}}C^{2}\left(\Omega\right)}\\
 & =L\frac{\sqrt{\Delta}}{r}C\left(\Omega\right)
\end{align*}

\end_inset

 where 
\begin_inset Formula 
\begin{align*}
\hat{g}_{xx}-\frac{\hat{g}^{2}_{tx}}{\hat{g}_{tt}} & =-\frac{A}{r^{4}}-\frac{\left[-\frac{A}{r^{3}}\left(\Omega-\omega_{d}\right)\right]^{2}}{C^{-2}\left(\Omega\right)}\\
 & =-\frac{A}{r^{4}}-\frac{\frac{A^{2}}{r^{6}}\left(\Omega-\omega_{d}\right)^{2}}{C^{-2}\left(\Omega\right)}\\
 & =-\frac{A}{r^{4}}-\frac{\frac{A^{2}}{r^{6}}\left(\Omega-\omega_{d}\right)^{2}}{\frac{\Delta r^{2}}{A}\left[1-\frac{A^{2}}{\Delta r^{4}}\left(\Omega-\omega_{d}\right)^{2}\right]}\\
 & =-\frac{A}{r^{4}}-\frac{A}{r^{4}}\frac{\frac{A^{2}}{\Delta r^{4}}\left(\Omega-\omega_{d}\right)^{2}}{1-\frac{A^{2}}{\Delta r^{4}}\left(\Omega-\omega_{d}\right)^{2}}\\
 & =\frac{A}{r^{4}}\left[-1+\frac{-\frac{A^{2}}{\Delta r^{4}}\left(\Omega-\omega_{d}\right)^{2}}{1-\frac{A^{2}}{\Delta r^{4}}\left(\Omega-\omega_{d}\right)^{2}}\right]\\
 & =\frac{A}{r^{4}}\left[-1+\left(1-\frac{1}{1-\frac{A^{2}}{\Delta r^{4}}\left(\Omega-\omega_{d}\right)^{2}}\right)\right]\\
 & =-\frac{A}{r^{4}}\frac{1}{1-\frac{A^{2}}{\Delta r^{4}}\left(\Omega-\omega_{d}\right)^{2}}\\
 & =-\frac{\Delta}{r^{2}}\frac{1}{\frac{\Delta r^{2}}{A}\left[1-\frac{A^{2}}{\Delta r^{4}}\left(\Omega-\omega_{d}\right)^{2}\right]}\\
 & =-\frac{\Delta}{r^{2}}\frac{1}{C^{-2}\left(\Omega\right)}\\
 & =-\frac{\Delta}{r^{2}}C^{2}\left(\Omega\right)
\end{align*}

\end_inset

 Here,
 
\begin_inset Formula 
\begin{align*}
\frac{-\frac{A^{2}}{\Delta r^{4}}\left(\Omega-\omega_{d}\right)^{2}}{1-\frac{A^{2}}{\Delta r^{4}}\left(\Omega-\omega_{d}\right)^{2}} & =\frac{1-\frac{A^{2}}{\Delta r^{4}}\left(\Omega-\omega_{d}\right)^{2}}{1-\frac{A^{2}}{\Delta r^{4}}\left(\Omega-\omega_{d}\right)^{2}}-\frac{1}{1-\frac{A^{2}}{\Delta r^{4}}\left(\Omega-\omega_{d}\right)^{2}}\\
 & =1-\frac{1}{1-\frac{A^{2}}{\Delta r^{4}}\left(\Omega-\omega_{d}\right)^{2}}
\end{align*}

\end_inset

 
\begin_inset Formula 
\[
C^{-2}\left(\Omega\right)=\frac{\Delta r^{2}}{A}\left[1-\frac{A^{2}}{\Delta r^{4}}\left(\Omega-\omega_{d}\right)^{2}\right]
\]

\end_inset

 We obtain 
\begin_inset Formula 
\[
L=L_{p}\frac{r}{C\left(\Omega\right)\sqrt{\Delta}}
\]

\end_inset

 
\begin_inset Formula 
\[
L^{4}=L^{4}_{p}\frac{r^{4}}{C^{4}\left(\Omega\right)\Delta^{2}}
\]

\end_inset

 The Casimir energy per unit volume is therefore 
\begin_inset Formula 
\begin{align*}
\langle\epsilon_{\text{vac}}\rangle & =-\frac{\pi^{2}}{1440L^{4}}\frac{r^{4}}{C^{4}\left(\Omega\right)\Delta^{2}}\\
 & =-\frac{\pi^{2}}{1440\left[L^{4}_{p}\frac{r^{4}}{C^{4}\left(\Omega\right)\Delta^{2}}\right]}\frac{r^{4}}{C^{4}\left(\Omega\right)\Delta^{2}}\\
 & =-\frac{\pi^{2}}{1440L^{4}_{p}}\frac{C^{4}\left(\Omega\right)\Delta^{2}}{r^{4}}\frac{r^{4}}{C^{4}\left(\Omega\right)\Delta^{2}}\\
 & =-\frac{\pi^{2}}{1440L^{4}_{p}}.
\end{align*}

\end_inset

 This is precisely the expression for the Casimir energy density in flat spacetime (Minkowski spacetime).
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\begin{gathered}\text{VI. Further Perspectives: Geometry and Boundary Conditions}\\
\text{in the Constant-Metric Approximation}
\end{gathered}
\]

\end_inset


\end_layout

\begin_layout Standard
Once the metric is approximated as constant,
 the spacetime is in fact Minkowski spacetime.
 A linear coordinate transformation with constant coefficients brings the line element into the standard Minkowski form.
 Let 
\begin_inset Formula $\bar{g}_{\mu\nu}$
\end_inset

 denote the metric components after this approximation.
 Completing the square gives 
\begin_inset Formula 
\[
ds^{2}=\bar{g}_{tt}\left(dt+\frac{\bar{g}_{tx}}{\bar{g}_{tt}}dx\right)^{2}+\left(\bar{g}_{xx}-\frac{\bar{g}^{2}_{tx}}{\bar{g}_{tt}}\right)dx^{2}+\bar{g}_{yy}dy^{2}+\bar{g}_{zz}dz^{2},
\]

\end_inset

 where all metric coefficients on the right-hand side are fixed constants.
 Set 
\begin_inset Formula 
\begin{align*}
dT & =\sqrt{\bar{g}_{tt}}\left(dt+\frac{\bar{g}_{tx}}{\bar{g}_{tt}}dx\right),\\
dX & =\sqrt{-\left(\bar{g}_{xx}-\frac{\bar{g}^{2}_{tx}}{\bar{g}_{tt}}\right)}dx,\\
dY & =\sqrt{-\bar{g}_{yy}}dy,\\
dZ & =\sqrt{-\bar{g}_{zz}}dz,
\end{align*}

\end_inset

 or apply the affine transformation 
\begin_inset Formula 
\begin{align*}
T-T_{0} & =\sqrt{\bar{g}_{tt}}\left[\left(t-t_{0}\right)+\frac{\bar{g}_{tx}}{\bar{g}_{tt}}\left(x-x_{0}\right)\right],\\
X-X_{0} & =\sqrt{-\left(\bar{g}_{xx}-\frac{\bar{g}^{2}_{tx}}{\bar{g}_{tt}}\right)}\left(x-x_{0}\right),\\
Y-Y_{0} & =\sqrt{-\bar{g}_{yy}}\left(y-y_{0}\right),\\
Z-Z_{0} & =\sqrt{-\bar{g}_{zz}}\left(z-z_{0}\right),
\end{align*}

\end_inset

 Here,
 all radicands are greater than 
\begin_inset Formula $0$
\end_inset

 when the worldline of the cavity center is timelike and 
\begin_inset Formula $r_{0}>r_{+}$
\end_inset

,
 
\begin_inset Formula $\theta_{0}=\pi/2$
\end_inset

.
 All coordinate values with subscript 
\begin_inset Formula $0$
\end_inset

 are constants and can be set to 
\begin_inset Formula $0$
\end_inset

 by suitable choices of the respective coordinate origins.
 We then obtain 
\begin_inset Formula 
\[
ds^{2}=dT^{2}-dX^{2}-dY^{2}-dZ^{2}.
\]

\end_inset

 In this coordinate system,
 the Dirichlet boundary conditions become 
\begin_inset Formula 
\[
\Psi\left(T,X=0,Y,Z\right)=\Psi\left(T,X=\frac{\sqrt{\Delta}}{r}C\left(\Omega\right)L,Y,Z\right)=0,
\]

\end_inset

 When 
\begin_inset Formula 
\[
x=L
\]

\end_inset

 we have 
\begin_inset Formula 
\begin{align*}
X & =\sqrt{-\left(\hat{g}_{xx}-\frac{\hat{g}^{2}_{tx}}{\hat{g}_{tt}}\right)}\cdot L\\
 & =\frac{\sqrt{\Delta}}{r}C\left(\Omega\right)L.
\end{align*}

\end_inset

 This also explains why,
 after transforming the line element into the standard Minkowski form,
 the positions of the two parallel plates are no longer both expressed in the same form as 
\begin_inset Formula $X=0$
\end_inset

 and 
\begin_inset Formula $X=L$
\end_inset

.
\end_layout

\begin_layout Standard
From the viewpoint of spacetime curvature,
 approximating the metric components as constants gives 
\begin_inset Formula 
\[
\partial_{\lambda}\bar{g}_{\mu\nu}=0,
\]

\end_inset

 
\begin_inset Formula 
\[
\bar{\Gamma}^{\sigma}_{\!\mu\nu}=\frac{1}{2}\bar{g}^{\sigma\rho}\left(\partial_{\mu}\bar{g}_{\nu\rho}+\partial_{\nu}\bar{g}_{\rho\mu}-\partial_{\rho}\bar{g}_{\mu\nu}\right)=0,
\]

\end_inset

 
\begin_inset Formula 
\[
\bar{R}^{\rho}_{\!\sigma\mu\nu}=\partial_{\mu}\bar{\Gamma}^{\rho}_{\!\nu\sigma}-\partial_{\nu}\bar{\Gamma}^{\rho}_{\!\mu\sigma}+\bar{\Gamma}^{\rho}_{\!\mu\lambda}\bar{\Gamma}^{\lambda}_{\!\nu\sigma}-\bar{\Gamma}^{\rho}_{\!\nu\lambda}\bar{\Gamma}^{\lambda}_{\!\mu\sigma}=0,
\]

\end_inset

 Thus,
 every component of the Riemann curvature tensor is 
\begin_inset Formula $0$
\end_inset

.
 This is precisely what it means for spacetime to be flat,
 and its physical properties are naturally those of flat spacetime.
 Unless otherwise necessary,
 the corresponding physical problem can therefore be studied entirely in flat spacetime.
\end_layout

\begin_layout Standard
For parallel plates in flat spacetime undergoing circular motion about an external center,
 the Casimir energy need not be the same as when the plates are at rest in an inertial frame,
 because their motion is noninertial.
 In the present analysis and in the original paper under discussion,
 however,
 this motion is effectively approximated as inertial.
 This can be understood in two ways for parallel plates in circular motion.
 First,
 in a coordinate system at rest relative to the plates,
 the metric depends on position.
 Second,
 in standard inertial Minkowski coordinates,
 the boundary conditions depend on time.
 In the present analysis,
 adopting the constant-metric approximation allows a transformation to the standard Minkowski form of the metric,
 while time-independent boundary conditions similar to those for plates at rest in an inertial frame are still imposed.
 This clearly describes the physical situation of stationary parallel plates,
 rather than that of parallel plates in circular motion.
\end_layout

