\begin_inset Formula 
\[
\hat{g}^{\mu\nu}=\begin{pmatrix}\frac{A}{\Delta r^{2}} & \frac{A}{\Delta r}\left(\omega_{d}-\Omega\right) & 0 & 0\\
\frac{A}{\Delta r}\left(\omega_{d}-\Omega\right) & -\frac{r^{2}}{\Delta}C^{-2}\left(\Omega\right) & 0 & 0\\
