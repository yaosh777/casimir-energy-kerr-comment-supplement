\begin_inset Formula 
\[
\hat{g}_{\mu\nu}=\begin{pmatrix}C^{-2}\left(\Omega\right) & -\frac{A}{r^{3}}\left(\Omega-\omega_{d}\right) & 0 & 0\\
-\frac{A}{r^{3}}\left(\Omega-\omega_{d}\right) & -\frac{A}{r^{4}} & 0 & 0\\
0 & 0 & -\frac{r^{2}}{\Delta} & 0\\
0 & 0 & 0 & -1
\end{pmatrix},
\]

